NODE_ENV=development
PORT=8000

# Telegram
BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-secret
PUBLIC_BASE_URL=https://your-service.koyeb.app

# Persistence
DATABASE_URL=postgres://degenlab:degenlab@localhost:5432/degenlab
# Local without Postgres:
# DATABASE_URL=pglite:./data/degenlab
# REDIS_URL=redis://localhost:6379

# Solana (use a dedicated RPC provider in production)
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Optional market-data vendor key
# MARKET_DATA_API_KEY=

# Practice engine
PRACTICE_STARTING_BALANCE=10000
QUOTE_MAX_AGE_SECONDS=30
PRACTICE_FEE_BPS=30
PRACTICE_SLIPPAGE_BPS=50
ENABLE_DEVNET_WALLET_VIEW=false
